    "dcnsw_iop_ln":             ("日累计次数本地网光路", "本地网光路的日累计次数"),
    "dcnsw_iop_ots":            ("日累计次数一二干光路", "一干和二干光路的日累计次数"),
    "r_dcnsw_iop_ln":           ("日累计恢复次数本地网光路", "本地网光路的日累计恢复次数"),
