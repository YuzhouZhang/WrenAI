"""
批量修改模型 ID=66 (API_PMC_CORE_BIG_P_KPI_15MIN) 的显示名和描述
使用精确的字段映射数据，通过 wren-ui GraphQL API 更新
"""

import requests
import json
import sys

# ========== 配置 ==========
GRAPHQL_URL = "http://wren-ui:3000/api/graphql"
MODEL_ID = 79
MODEL_NEW_DISPLAY_NAME = "政企业务支撑平台_订购客户信息表"
MODEL_NEW_DESCRIPTION = "存储订购客户的基本信息，包括客户名称、客户编号、客户级别、客户服务级别、集团地址、集团类型、集团客户级别、集团客户行业、集团客户联系人信息等，用于客户管理和业务分析。"
# ==========================

# ===== 精确字段映射 (英文引用名 -> 中文显示名, 描述) =====
# 键为小写引用名（与 WrenAI 中存储的一致）
FIELD_MAP = {
    "tid": ("主键UUID", "唯一标识记录"),
    "gmt_create": ("创建时间", "记录创建时间"),
    "gmt_modify": ("修改时间", "记录修改时间"),
    "changetype": (
        "数据状态0-正常1-删除",
        "数据状态标识。候选值及业务含义如下：\n- 0: 正常\n- 1: 删除\n\nSQL 过滤生成规则提示：\n- 问：“正常的客户数据” -> WHERE changetype = 0\n- 问：“被删除的客户” -> WHERE changetype = 1"
    ),
    "province_code": ("省份编码", "省份编码"),
    "region_code": ("地市编码", "地市编码"),
    "county_code": ("区县编码", "区县编码"),
    "province_name": ("省份名称", "省份名称"),
    "region_name": (
        "地市名称",
        "地市名称。表示该订购客户所属的城市。\n\n"
        "该字段的候选值（Distinct 值）仅包含浙江省的 11 个地市：\n"
        "- 杭州市, 宁波市, 温州市, 嘉兴市, 湖州市, 绍兴市, 金华市, 衢州市, 舟山市, 台州市, 丽水市\n\n"
        "SQL 过滤生成规则提示：\n"
        "1. 字段中的地市名称均带有“市”后缀。如果用户查询“杭州”、“温州”等不带“市”的名称，必须自动补齐“市”后缀进行匹配。\n"
        "   - 问：“杭州的订购客户有哪些” -> WHERE region_name = '杭州市'\n"
        "   - 问：“温州和宁波的客户数” -> WHERE region_name IN ('温州市', '宁波市')"
    ),
    "county_name": ("区县名称", "区县名称"),
    "custom_name": ("客户名称", "客户名称"),
    "custom_no": ("客户编号", "客户编号"),
    "custom_level": (
        "客户级别0A1高贡献1A2高全量2B1中高贡献3B2中高",
        "客户级别。候选值及其对应的业务含义如下：\n"
        "- 0: A1（高贡献）\n"
        "- 1: A2（高全量）\n"
        "- 2: B1（中高贡献）\n"
        "- 3: B2（中高全量）\n"
        "- 5: C1\n"
        "- 6: C2\n"
        "- 7: D\n"
        "- 9: E（产品集团）\n\n"
        "SQL 过滤生成规则提示：\n"
        "- 问：“A1高贡献级别的客户数” -> WHERE custom_level = '0'\n"
        "- 问：“B1中高贡献级别的客户” -> WHERE custom_level = '2'"
    ),
    "custom_svc_level": (
        "客户服务级别金牌银牌铜牌标准",
        "客户服务级别。表示客户的服务等级。\n"
        "候选值包括：金牌、银牌、铜牌、标准。\n\n"
        "SQL 过滤生成规则提示：\n"
        "- 问：“金牌客户有哪些” -> WHERE custom_svc_level = '金牌'\n"
        "- 问：“银牌或铜牌服务级别的客户数量” -> WHERE custom_svc_level IN ('银牌', '铜牌')"
    ),
    "street_name": ("所属街道乡镇", "所属街道乡镇"),
    "custom_contact_add": ("集团地址", "集团地址"),
    "custom_type": ("集团类型", "集团类型"),
    "group_customer_level": ("集团客户级别", "集团客户级别"),
    "group_customer_trade": ("集团客户级别", "集团客户级别"),
    "custom_industry": ("集团客户行业", "集团客户行业"),
    "custom_contact": ("集团客户业务联系人", "集团客户业务联系人"),
    "custom_contact_phone": ("集团客户业务联系人电话", "集团客户业务联系人电话"),
    "custom_contact_email": ("集团客户业务联系人邮箱", "集团客户业务联系人邮箱"),
    "tech_contact": ("集团客户技术联系人", "集团客户技术联系人"),
    "tech_contact_phone": ("集团客户技术联系人电话", "集团客户技术联系人电话"),
    "tech_contact_email": ("集团客户技术联系人邮箱", "集团客户技术联系人邮箱"),
    "c_manager_contact": ("客户经理", "客户经理"),
    "c_manager_contact_phone": ("客户经理联系电话", "客户经理联系电话"),
    "c_manager_contact_email": ("客户经理联系邮箱", "客户经理联系邮箱"),
    "is_history": (
        "是否历史数据1历史数据",
        "是否历史数据标识。0或null表示当前正常数据，1表示历史数据。\n\n"
        "SQL 过滤生成规则提示：\n"
        "- 问：“查询历史客户数据” -> WHERE is_history = 1\n"
        "- 问：“查询当前正常的订购客户” -> WHERE is_history = 0"
    ),
}


def graphql_request(query, variables=None):
    """发送 GraphQL 请求"""
    payload = {"query": query}
    if variables:
        payload["variables"] = variables
    try:
        resp = requests.post(GRAPHQL_URL, json=payload, timeout=30)
        resp.raise_for_status()
        result = resp.json()
        if "errors" in result:
            print(f"❌ GraphQL 错误: {json.dumps(result['errors'], ensure_ascii=False, indent=2)}")
            return None
        return result
    except Exception as e:
        print(f"❌ 请求失败: {e}")
        return None


def get_model_fields(model_id):
    """查询指定模型的所有字段"""
    query = """
    query {
        listModels {
            id
            displayName
            referenceName
            description
            fields {
                id
                displayName
                referenceName
                properties
            }
        }
    }
    """
    result = graphql_request(query)
    if not result:
        return None, None
    for model in result["data"]["listModels"]:
        if model["id"] == model_id:
            return model, model["fields"]
    return None, None


def preview_changes(model, fields):
    """预览所有将要修改的内容"""
    print("\n" + "=" * 100)
    print("  📋 变更预览")
    print("=" * 100)

    print(f"\n  【模型】")
    print(f"  当前别名: {model['displayName']}")
    print(f"  新的别名: {MODEL_NEW_DISPLAY_NAME}")
    print(f"  新的描述: {MODEL_NEW_DESCRIPTION}")

    columns_update = []
    matched = 0
    unmatched = 0

    print(f"\n  【字段变更】(共 {len(fields)} 个字段)")
    print(f"  {'ID':<6} {'引用名':<30} {'当前显示名':<30} → {'新显示名':<30} {'新描述'}")
    print(f"  {'─'*6} {'─'*30} {'─'*30}   {'─'*30} {'─'*30}")

    for f in fields:
        ref_name = f["referenceName"]
        if ref_name in FIELD_MAP:
            new_display, new_desc = FIELD_MAP[ref_name]
            old_display = f["displayName"]
            old_desc = ""
            if f.get("properties") and isinstance(f["properties"], dict):
                old_desc = f["properties"].get("description", "")

            changed = (old_display != new_display) or (old_desc != new_desc)
            marker = "🔄" if changed else "✅"
            print(f"  {marker} {f['id']:<4} {ref_name:<28} {old_display:<28} → {new_display:<28} {new_desc}")

            columns_update.append({
                "id": f["id"],
                "displayName": new_display,
                "description": new_desc
            })
            matched += 1
        else:
            print(f"  ⚠️  {f['id']:<4} {ref_name:<28} {f['displayName']:<28} → (未在映射表中，跳过)")
            unmatched += 1

    print(f"\n  📊 统计: 匹配 {matched} 个字段, 未匹配 {unmatched} 个字段")
    print(f"  📝 映射表共 {len(FIELD_MAP)} 条记录")
    return columns_update


def execute_update(model_id, columns_update):
    """执行更新"""
    mutation = """
    mutation UpdateModelMetadata($where: ModelWhereInput!, $data: UpdateModelMetadataInput!) {
        updateModelMetadata(where: $where, data: $data)
    }
    """
    variables = {
        "where": {"id": model_id},
        "data": {
            "displayName": MODEL_NEW_DISPLAY_NAME,
            "description": MODEL_NEW_DESCRIPTION,
            "columns": columns_update
        }
    }

    print("\n⏳ 正在提交更新...")
    result = graphql_request(mutation, variables)
    if result and result.get("data", {}).get("updateModelMetadata"):
        print("✅ 模型元数据更新成功！")
        return True
    else:
        print("❌ 更新失败")
        return False


def deploy():
    """触发 Deploy"""
    mutation = "mutation { deploy }"
    print("\n⏳ 正在 Deploy...")
    result = graphql_request(mutation)
    if result:
        print("✅ Deploy 成功，变更已生效！")
    else:
        print("❌ Deploy 失败，请手动在 UI 上点击 Deploy")


if __name__ == "__main__":
    print(f"🔍 正在查询模型 ID={MODEL_ID} 的信息...\n")

    model, fields = get_model_fields(MODEL_ID)
    if not model:
        print(f"❌ 未找到模型 ID={MODEL_ID}")
        sys.exit(1)

    print(f"  找到模型: {model['displayName']} ({model['referenceName']})")
    print(f"  共 {len(fields)} 个字段")

    # 1. 预览
    columns = preview_changes(model, fields)

    # 2. 确认
    print("\n" + "=" * 100)
    confirm = input("  ❓ 是否执行以上变更? (y/n): ").strip().lower()
    if confirm != "y":
        print("  ❎ 已取消")
        sys.exit(0)

    # 3. 更新
    success = execute_update(MODEL_ID, columns)

    # 4. Deploy
    if success:
        deploy_confirm = input("\n  ❓ 是否立即 Deploy? (y/n): ").strip().lower()
        if deploy_confirm == "y":
            deploy()
        else:
            print("  ⚠️  请记得手动 Deploy！")

    print("\n🏁 完成")
