"""
批量修改模型 ID=45 (网路受损机房受损区域15分) 的显示名和描述
使用精确的字段映射数据，通过 wren-ui GraphQL API 更新
"""

import requests
import json
import sys

# ========== 配置 ==========
GRAPHQL_URL = "http://wren-ui:3000/api/graphql"
MODEL_ID = 45
MODEL_NEW_DISPLAY_NAME = "网路受损机房受损区域15分"
