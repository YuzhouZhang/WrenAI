FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    ca-certificates \
    iputils-ping \
    net-tools \
    iproute2 \
    dnsutils \
    telnet \
    traceroute \
    tcpdump \
    netcat-openbsd \
    mtr \
    nmap \
    iperf3 \
    socat \
    lsof \
    jq \
    procps \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir wrenai==0.12.0

WORKDIR /app

CMD ["sleep", "infinity"]

